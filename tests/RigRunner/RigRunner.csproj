<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the in-game test rig (a stock KSP with LMP and kRPC, see Meat and Potatoes 26) through kRPC, and compares what
       the game says with what the LUNA EVO server plugin received. Run by hand, never by dotnet test: it needs KSP. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- kRPC's C# client is built for .NET Framework 4.7.2; it works on .NET 10 (checked on the rig). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KRPC.Client" Version="0.7.0" />
  </ItemGroup>

</Project>
