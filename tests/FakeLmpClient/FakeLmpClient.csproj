<Project Sdk="Microsoft.NET.Sdk">

  <!-- A pretend LMP player with no KSP: connects to a real LMP server and sends real LMP messages (built with LMP's own
       message code from Server.dll). For testing the server plugin and, later, the server checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Server">
      <HintPath>..\Fixtures\LMPServer\Server.dll</HintPath>
    </Reference>
    <Reference Include="Lidgren.Core">
      <HintPath>..\Fixtures\LMPServer\Lidgren.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
