<Project Sdk="Microsoft.NET.Sdk">

  <!-- LUNA EVO's patches for the official LMP client: a KSP mod (GameData/000_LunaEvoPatches) that changes LMP's code
       as KSP loads, with the Harmony that LMP itself ships. It compiles against KSP's and LMP's own DLLs from a KSP
       install (KspDir, the test rig by default), which can't be in a public repo, so it only builds where they exist:
       not on CI. See Meat and Potatoes 27. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyName>LunaEvo.ClientPatches</AssemblyName>
    <RootNamespace>LunaEvo.ClientPatches</RootNamespace>
    <!-- The test rig's stock KSP, next to the repo folder (LUNA EVOLVED/TestRig/KSP); pass -p:KspDir=... for another. -->
    <KspDir Condition="'$(KspDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\TestRig\KSP</KspDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KspDir)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KspDir)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KspDir)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LmpClient"><HintPath>$(KspDir)\GameData\LunaMultiplayer\Plugins\LmpClient.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(KspDir)\GameData\LunaMultiplayer\Plugins\Lidgren.Network.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(KspDir)\GameData\000_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
