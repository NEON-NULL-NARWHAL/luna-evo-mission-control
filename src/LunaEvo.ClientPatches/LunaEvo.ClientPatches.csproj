<Project Sdk="Microsoft.NET.Sdk">

  <!-- LUNA EVO's patches for the official LMP client: a KSP mod (GameData/000_LunaEvoPatches) that changes LMP's code
       as KSP loads, with the Harmony that LMP itself ships. It builds anywhere, CI included, with no KSP installed:
       LMP's client (MIT) comes from tests/Fixtures/LmpClient, Harmony (MIT) from NuGet, and the few KSP and Unity
       names it uses from LUNA EVO's own stand-ins in Stubs/ (no Squad or Unity code). In the game, KSP's real
       assemblies are used. See Meat and Potatoes 27. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>1.2.0</Version>
    <AssemblyName>LunaEvo.ClientPatches</AssemblyName>
    <RootNamespace>LunaEvo.ClientPatches</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- LMP 0.29.2 ships Harmony 2.2.1 (HarmonyKSP); 2.2.2 has the same API, and in the game LMP's copy is the one used. -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Stubs\AssemblyCSharp\AssemblyCSharp.csproj" Private="false" />
    <ProjectReference Include="Stubs\UnityCoreModule\UnityCoreModule.csproj" Private="false" />
    <Reference Include="LmpClient"><HintPath>..\..\tests\Fixtures\LmpClient\LmpClient.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>..\..\tests\Fixtures\LmpClient\Lidgren.Network.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Stubs\**" />
  </ItemGroup>

</Project>
