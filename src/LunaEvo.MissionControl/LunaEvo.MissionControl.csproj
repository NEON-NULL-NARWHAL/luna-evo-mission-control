<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LunaEvo.MissionControl</AssemblyName>
    <Product>LUNA EVO Mission Control</Product>
    <!-- FileDescription: Windows shows it as the app name on notifications. -->
    <AssemblyTitle>LUNA EVO Mission Control</AssemblyTitle>
    <Version>2.4.0</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaEvo.MissionControl.Core\LunaEvo.MissionControl.Core.csproj" />
    <!-- The LUNA EVO server plugin (net6.0, for LMP 0.29's server): built first, then carried inside the exe so
         installing it into a server is a copy, not a download. -->
    <ProjectReference Include="..\LunaEvo.ServerPlugin\LunaEvo.ServerPlugin.csproj" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=net6.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\LunaEvo.ServerPlugin\bin\$(Configuration)\net6.0\LunaEvo.ServerPlugin.dll" LogicalName="LunaEvo.ServerPlugin.dll" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunaEvo.MissionControl.Tests" />
  </ItemGroup>

</Project>
