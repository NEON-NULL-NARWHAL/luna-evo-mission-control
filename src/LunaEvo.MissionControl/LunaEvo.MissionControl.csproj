<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LunaEvo.MissionControl</AssemblyName>
    <Product>LUNA EVO Mission Control</Product>
    <!-- FileDescription: Windows shows it as the app name on notifications. -->
    <AssemblyTitle>LUNA EVO Mission Control</AssemblyTitle>
    <Version>2.9.2</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The client patches are a .NET Framework 4.7.2 KSP mod, only carried inside the exe (never loaded by it). -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaEvo.MissionControl.Core\LunaEvo.MissionControl.Core.csproj" />
    <!-- The LUNA EVO server plugin (net6.0, for LMP 0.29's server): built first, then carried inside the exe so
         installing it into a server is a copy, not a download. -->
    <ProjectReference Include="..\LunaEvo.ServerPlugin\LunaEvo.ServerPlugin.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\LunaEvo.ServerPlugin\bin\$(Configuration)\net6.0\LunaEvo.ServerPlugin.dll" LogicalName="LunaEvo.ServerPlugin.dll" />
    <EmbeddedResource Include="..\LunaEvo.ServerPlugin\bin\$(Configuration)\net6.0\0Harmony.dll" LogicalName="LunaEvo.ServerPlugin.0Harmony.dll" />
  </ItemGroup>

  <!-- LUNA EVO's patches for the LMP client (net472, a KSP mod): built first, then carried inside the exe like the
       server plugin. They build without KSP (stand-ins in LunaEvo.ClientPatches/Stubs), so every build has them. -->
  <ItemGroup>
    <ProjectReference Include="..\LunaEvo.ClientPatches\LunaEvo.ClientPatches.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <EmbeddedResource Include="..\LunaEvo.ClientPatches\bin\$(Configuration)\net472\LunaEvo.ClientPatches.dll" LogicalName="LunaEvo.ClientPatches.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The What's new tab reads the CHANGELOG carried inside the exe (it works offline). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="LunaEvo.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunaEvo.MissionControl.Tests" />
  </ItemGroup>

</Project>
